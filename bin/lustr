#!/usr/bin/env bash
# Lustr — polish your Mac. Keep what matters.
# https://github.com/TheWarrior-tech/Lustr

set -euo pipefail

# Resolve install location (supports symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
LUSTR_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# shellcheck source=/dev/null
source "$LUSTR_ROOT/lib/common.sh"
# shellcheck source=/dev/null
source "$LUSTR_ROOT/lib/ui.sh"
# shellcheck source=/dev/null
source "$LUSTR_ROOT/lib/safety.sh"
# shellcheck source=/dev/null
source "$LUSTR_ROOT/lib/scan.sh"
# shellcheck source=/dev/null
source "$LUSTR_ROOT/lib/clean.sh"
# shellcheck source=/dev/null
source "$LUSTR_ROOT/lib/analyze.sh"
# shellcheck source=/dev/null
source "$LUSTR_ROOT/lib/status.sh"

LUSTR_DRY_RUN=0
LUSTR_YES=0
LUSTR_QUIET=0
INCLUDE_ARCHIVES=0

usage_exit() {
  ui_help
  exit "${1:-0}"
}

parse_global_flags() {
  local -a kept=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) LUSTR_DRY_RUN=1; shift ;;
      --yes|-y)     LUSTR_YES=1; shift ;;
      --quiet|-q)   LUSTR_QUIET=1; shift ;;
      --no-color)   export NO_COLOR=1; shift ;;
      --include-archives) INCLUDE_ARCHIVES=1; shift ;;
      --help|-h)    usage_exit 0 ;;
      --version|-V) echo "Lustr $LUSTR_VERSION"; exit 0 ;;
      --) shift; kept+=("$@"); break ;;
      -*)
        ui_error "Unknown option: $1"
        printf "  Run ${CYAN}lustr help${RESET} for usage.\n\n"
        exit 1
        ;;
      *) kept+=("$1"); shift ;;
    esac
  done
  if ((${#kept[@]})); then
    set -- "${kept[@]}"
  else
    set --
  fi
  # Export remaining into global ARGS
  LUSTR_ARGS=("$@")
}

cmd_scan() {
  ui_banner
  lustr_scan
  lustr_scan_print
}

cmd_clean() {
  ui_banner

  # Always scan first so the user sees what will happen
  lustr_scan
  lustr_scan_print "$([[ "$LUSTR_DRY_RUN" == "1" ]] && echo 1 || echo 0)"

  if (( SCAN_TOTAL == 0 )); then
    ui_success "Already clean — nothing to do."
    printf "\n"
    return 0
  fi

  if [[ "$LUSTR_DRY_RUN" == "1" ]]; then
    lustr_clean
    return 0
  fi

  if [[ "$LUSTR_YES" != "1" ]]; then
    printf "\n"
    ui_warn "This permanently deletes caches, logs, and Trash contents."
    ui_dim "Documents, Photos, Mail, Messages, Keychains, and apps are never touched."
    printf "\n"
    if ! confirm "Proceed with clean?" "n"; then
      ui_info "Cancelled — no changes made."
      printf "\n"
      return 0
    fi
    printf "\n"
  fi

  lustr_clean
}

cmd_analyze() {
  ui_banner
  lustr_analyze
}

cmd_status() {
  ui_banner
  lustr_status
}

cmd_update() {
  ui_banner
  ui_section "Update"
  ui_info "Fetching latest Lustr..."
  local url="https://raw.githubusercontent.com/TheWarrior-tech/Lustr/main/install.sh"
  if curl -fsSL "$url" | bash; then
    ui_success "Lustr is up to date."
  else
    ui_error "Update failed. Check your network or install manually."
    exit 1
  fi
  printf "\n"
}

cmd_uninstall() {
  ui_banner
  ui_section "Uninstall"
  ui_info "This removes the Lustr CLI from your system."
  ui_dim "Your files and data are not affected."
  printf "\n"
  if [[ "$LUSTR_YES" != "1" ]]; then
    if ! confirm "Uninstall Lustr?" "n"; then
      ui_info "Cancelled."
      printf "\n"
      return 0
    fi
  fi

  local targets=(
    "$HOME/.lustr"
    "/usr/local/bin/lustr"
    "$HOME/.local/bin/lustr"
  )
  # Also remove brew-style if we installed to /opt
  local p
  p=$(command -v lustr 2>/dev/null || true)

  if [[ -x "$HOME/.lustr/bin/lustr" ]] || [[ -d "$HOME/.lustr" ]]; then
    rm -rf "$HOME/.lustr"
    ui_success "Removed ~/.lustr"
  fi

  for link in /usr/local/bin/lustr "$HOME/.local/bin/lustr"; do
    if [[ -L "$link" || -f "$link" ]]; then
      if rm -f "$link" 2>/dev/null; then
        ui_success "Removed $link"
      else
        # may need sudo
        if sudo rm -f "$link" 2>/dev/null; then
          ui_success "Removed $link"
        else
          ui_warn "Could not remove $link — delete it manually."
        fi
      fi
    fi
  done

  printf "\n"
  ui_success "Lustr has been uninstalled. Thanks for trying it."
  printf "\n"
}

cmd_interactive() {
  local choice
  choice=$(ui_menu)
  printf "\n"
  case "$choice" in
    1|s|scan)     cmd_scan ;;
    2|c|clean)    cmd_clean ;;
    3|a|analyze)  cmd_analyze ;;
    4|st|status)  cmd_status ;;
    5|d|dry)      LUSTR_DRY_RUN=1; cmd_clean ;;
    q|Q|quit|exit|"") ui_dim "Goodbye."; printf "\n"; exit 0 ;;
    *) ui_error "Unknown choice."; exit 1 ;;
  esac
}

main() {
  require_macos

  # Re-source colors if --no-color was early
  parse_global_flags "$@"
  set -- "${LUSTR_ARGS[@]:-}"

  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    ""|menu|interactive) cmd_interactive ;;
    scan)     cmd_scan ;;
    clean)    cmd_clean ;;
    analyze|analyse) cmd_analyze ;;
    status)   cmd_status ;;
    update)   cmd_update ;;
    uninstall|remove) cmd_uninstall ;;
    help|--help|-h) usage_exit 0 ;;
    version|--version|-V) echo "Lustr $LUSTR_VERSION"; exit 0 ;;
    *)
      ui_error "Unknown command: $cmd"
      printf "  Run ${CYAN}lustr help${RESET} for usage.\n\n"
      exit 1
      ;;
  esac
}

main "$@"
